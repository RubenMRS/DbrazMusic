<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MusicBot</RootNamespace>
    <AssemblyName>MusicBot</AssemblyName>
  </PropertyGroup>

  <!--
    Discord.Net 3.20.2 (NuGet) tem um bug no DAVE (E2EE) que impede a voz de funcionar:
    https://github.com/discord-net/Discord.Net/issues/3281
    Estas DLLs foram compiladas a partir da 3.20.2 com o patch do PR #3288 aplicado.
  -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <Reference Include="Discord.Net.Core">
      <HintPath>libs\Discord.Net.Core.dll</HintPath>
    </Reference>
    <Reference Include="Discord.Net.Rest">
      <HintPath>libs\Discord.Net.Rest.dll</HintPath>
    </Reference>
    <Reference Include="Discord.Net.WebSocket">
      <HintPath>libs\Discord.Net.WebSocket.dll</HintPath>
    </Reference>
    <Reference Include="Discord.Net.Dave">
      <HintPath>libs\Discord.Net.Dave.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Bibliotecas nativas que o Discord.Net precisa para a voz (vão para a pasta de saída).
       No Linux (Docker) vêm do sistema, por isso só se copiam no Windows. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <None Include="natives\libsodium.dll" Link="libsodium.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="natives\opus.dll" Link="opus.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="natives\libdave.dll" Link="libdave.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Update="config.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Remove="tools\**" />
  </ItemGroup>

</Project>
